# offline = local Metal simnet + Airwallex simulator (no keys needed)
# live    = Metal testnet + Airwallex sandbox
QM_MODE=offline

# ---- Metal (live mode) ----
# Create an endpoint at https://console-testnet.metalntwx.com. The endpoint id is a credential.
METAL_RPC_URL=https://rpc-testnet.metalntwx.com/v1/<endpoint-id>
METAL_FACILITATOR_URL=https://x402-testnet.metalntwx.com/x402/facilitator
METAL_FAUCET_URL=
# Address you control that stands in for the Airwallex on-ramp (treasury mandate payee).
QM_RAMP_ADDRESS=

# ---- Airwallex sandbox (live mode) ----
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# ---- Claude planner (optional; a deterministic fallback runs without it) ----
ANTHROPIC_API_KEY=
QM_PLANNER_MODEL=claude-opus-5-5
QM_ASSIST_MODEL=claude-sonnet-5-5

# ---- Approvals ----
# Secret used to sign one-time approval links. Generate with: openssl rand -hex 32
QM_APPROVAL_SECRET=
